# 이 파일을 cutnote/.dev.vars 로 복사한 뒤 로컬에서만 값을 입력하세요.
# 실제 키/비밀번호/연결 코드는 포함하지 않습니다. DB/BUCKET은 환경변수가 아닌 바인딩입니다.
# 새 AES-GCM 키: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CUTNOTE_SECRET_KEY=
# 선택: 키가 없어도 보관함/수동 저장은 동작하며 유료 AI 분석은 실행할 수 없습니다.
# 웹 설정 화면에 키를 입력할 수도 있습니다. UI 저장 키가 환경변수보다 우선합니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
